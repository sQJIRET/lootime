# Скопируйте этот файл в .env и заполните значения

# Порт, на котором слушает сайт
PORT=3000

# Публичный адрес сайта БЕЗ слэша на конце (нужен HTTPS для callback Platega)
PUBLIC_URL=https://loontime.duckdns.org

# Пароль входа в админку (/admin) и секрет для подписи сессии
ADMIN_PASSWORD=поменяйте-меня
SESSION_SECRET=длинная-случайная-строка

# Ключ, по которому плагин на сервере Minecraft забирает заказы
# (такое же значение укажете в config.yml плагина)
PLUGIN_KEY=другая-длинная-случайная-строка

# Данные из личного кабинета Platega
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# Способы оплаты Platega через запятую: 2 = СБП, 10 = карты РФ, 11 = эквайринг, 12 = международные карты, 13 = крипта
PAYMENT_METHODS=2,10,13

# Где хранится база
DB_PATH=./data/shop.db

# 1 = за сайтом стоит nginx/Cloudflare (нужно для корректного IP)
TRUST_PROXY=0

# 1 = тестовый режим БЕЗ реальной оплаты (кнопка "оплатить" сразу выдаёт товар). В бою держите 0!
DEV_MODE=0

# Промокоды: КОД:скидка_в_процентах через запятую (необязательно)
PROMO_CODES=LOON10:10

# ===== Автоматический HTTPS (Let's Encrypt) =====
# Домен должен указывать на IP этого сервера (в DuckDNS), порты 80 и 443 должны быть свободны.
HTTPS_DOMAIN=loontime.duckdns.org
ACME_EMAIL=
# 1 = тестовый сертификат (для проверки, браузер ему не доверяет). В бою 0.
ACME_STAGING=0
# HTTP_PORT=80
# HTTPS_PORT=443
# При встроенном HTTPS TRUST_PROXY ставьте 0

# Хостинг с одним портом: доверенный сертификат через DNS-01 DuckDNS (порты 80/443 не нужны)
DUCKDNS_TOKEN=
DUCKDNS_DOMAIN=loontime.duckdns.org
